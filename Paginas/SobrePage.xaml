<UserControl x:Class="Hefesto.SobrePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40" MaxWidth="980" HorizontalAlignment="Left">

            <!-- Marca -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="72" Height="72" Margin="0,0,22,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Hefesto" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="46"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" FontSize="13" Margin="2,2,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" MaxWidth="760" HorizontalAlignment="Left">
                Diagnóstico, manutenção e jogos num só lugar. Gratuito e de código aberto, feito pela Kairós.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,18" MaxWidth="760" HorizontalAlignment="Left">
                O Hefesto nasceu do ResetExplode v0.16, de Gustavo (GustavoReset), publicado sob a licença MIT.
                Todo o histórico de commits do ResetExplode está preservado no repositório, e o aviso de copyright original
                acompanha o programa.
            </TextBlock>
            <WrapPanel Margin="0,0,0,34">
                <Button Style="{StaticResource OutlineButton}" Content="CÓDIGO-FONTE" Padding="16,8" Margin="0,0,10,8"
                        Tag="https://github.com/JoaoAntonio08/kairos-hefesto" Click="Link_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="DOWNLOADS OFICIAIS" Padding="16,8" Margin="0,0,10,8"
                        Tag="https://github.com/JoaoAntonio08/kairos-hefesto/releases" Click="Link_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="RESETEXPLODE (ORIGEM)" Padding="16,8" Margin="0,0,10,8"
                        Tag="https://github.com/GustavoReset/ResetExplode" Click="Link_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="PASTA DE CONFIGURAÇÕES" Padding="16,8" Margin="0,0,10,8"
                        Click="Settings_Click"/>
            </WrapPanel>

            <!-- Licenças -->
            <TextBlock Text="Licenças" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,16"
                       Text="Tudo o que veio de fora e as regras de cada licença. O texto completo de cada uma está no botão ao lado."/>

            <ItemsControl x:Name="LicenseList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                                            <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="9"
                                                    Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding License}" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Use}" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Copyright}" Foreground="{DynamicResource Faint}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <Button Style="{StaticResource OutlineButton}" Content="SITE" Padding="10,4" FontSize="11"
                                                Margin="0,0,8,0" Tag="{Binding Url}" Click="Link_Click"/>
                                        <ToggleButton x:Name="tg" Content="TEXTO DA LICENÇA" Padding="10,4" FontSize="11" Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="b" BorderBrush="{DynamicResource Fg}" BorderThickness="1" CornerRadius="10"
                                                            Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Fg}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                                <TextBox Text="{Binding FullText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="{StaticResource Mono}" FontSize="11.5" Margin="0,12,0,0" MaxHeight="360"
                                         VerticalScrollBarVisibility="Auto" Padding="12,10"
                                         Visibility="{Binding IsChecked, ElementName=tg, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,18,0,0" MaxWidth="760" HorizontalAlignment="Left">
                Emuladores e ports da página Clássicos, o PawnIO e o SDK da Corsair não vêm dentro do Hefesto: são baixados das
                fontes oficiais só quando você pede, e rodam como programas separados, cada um com a sua própria licença.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
