<UserControl x:Class="Hefesto.IaLocalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">
            <TextBlock Text="IA LOCAL" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Explica os relatórios do Hefesto em linguagem simples, usando um modelo de IA que roda no seu PC pelo Ollama. Nada é enviado para a internet."/>

            <!-- Configuração do Ollama -->
            <TextBlock x:Name="Estado" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20" Margin="0,22,0,0" Text="Verificando o Ollama…"/>
            <TextBlock x:Name="EstadoSub" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="BtnInstalar" Style="{StaticResource AccentButton}" Content="INSTALAR OLLAMA" Padding="18,10" Margin="0,0,10,8" Visibility="Collapsed" Click="Instalar_Click"/>
                <Button x:Name="BtnIniciar" Style="{StaticResource AccentButton}" Content="INICIAR OLLAMA" Padding="18,10" Margin="0,0,10,8" Visibility="Collapsed" Click="Iniciar_Click"/>
                <Button x:Name="BtnModelo" Style="{StaticResource AccentButton}" Content="BAIXAR MODELO" Padding="18,10" Margin="0,0,10,8" Visibility="Collapsed" Click="BaixarModelo_Click"/>
                <ComboBox x:Name="Modelos" MinWidth="200" Margin="0,0,10,8" Visibility="Collapsed" SelectionChanged="Modelos_SelectionChanged"/>
                <Button Style="{StaticResource OutlineButton}" Content="VERIFICAR DE NOVO" Padding="14,10" Margin="0,0,10,8" Click="Verificar_Click"/>
            </WrapPanel>

            <!-- Pergunta -->
            <TextBlock Text="O que explicar" Style="{StaticResource Label}" Margin="0,22,0,6"/>
            <WrapPanel>
                <Button Style="{StaticResource OutlineButton}" Content="ÚLTIMO RELATÓRIO DE LIMPEZA" Padding="14,8" Margin="0,0,10,8" Click="UltimaLimpeza_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="ABRIR RELATÓRIO…" Padding="14,8" Margin="0,0,10,8" Click="AbrirRelatorio_Click"/>
            </WrapPanel>
            <TextBox x:Name="Entrada" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="8"
                     ToolTip="Cole aqui um relatório, um erro ou uma pergunta"/>
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BtnExplicar" Style="{StaticResource AccentButton}" Content="EXPLICAR" Padding="24,10" Margin="0,0,10,8" Click="Explicar_Click"/>
                <Button x:Name="BtnParar" Style="{StaticResource OutlineButton}" Content="PARAR" Padding="16,10" Margin="0,0,10,8" Visibility="Collapsed" Click="Parar_Click"/>
            </WrapPanel>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16,12" x:Name="CaixaResposta" Visibility="Collapsed">
                <TextBox x:Name="Resposta" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="14"
                         Foreground="{DynamicResource Fg}"/>
            </Border>
            <TextBlock Foreground="{DynamicResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,16,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="A IA pode errar. Ela explica, mas não executa nada: toda ação continua passando pelas telas do Hefesto, com confirmação. Ollama (MIT) e os modelos têm licenças próprias."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
