<UserControl x:Class="Hefesto.ClassicosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">
            <TextBlock Text="CLÁSSICOS" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Emuladores e ports de código aberto, baixados direto das páginas oficiais no GitHub, conferidos pelo SHA-256 e abertos como programas separados. Atualizar mantém suas configurações."/>

            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0" Padding="14,6" Margin="0,18,0,0" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                           Text="O Hefesto não baixa, não inclui e não indica jogos, ROMs, BIOS, firmware ou dumps. Use cópias tiradas dos seus próprios jogos e consoles, como explicam os guias oficiais de cada projeto."/>
            </Border>

            <WrapPanel Margin="0,18,0,0">
                <Button x:Name="BtnVerificar" Style="{StaticResource OutlineButton}" Content="VERIFICAR ATUALIZAÇÕES" Padding="16,10" Margin="0,0,10,8" Click="Verificar_Click"/>
                <Button x:Name="BtnCancelar" Style="{StaticResource OutlineButton}" Content="CANCELAR" Padding="16,10" Margin="0,0,10,8" Visibility="Collapsed" Click="Cancelar_Click"/>
            </WrapPanel>
            <Grid Height="3" Margin="0,8,0,8" Background="{DynamicResource Line}">
                <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="Progresso" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text=" "/>

            <ItemsControl x:Name="Lista" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding C.Nome}" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20"/>
                                        <TextBlock Text="{Binding C.Plataforma}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="12,7,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding C.Descricao}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding C.Requer}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Situacao}" Foreground="{DynamicResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" MaxWidth="330" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource AccentButton}" Content="ABRIR" Padding="18,8" Margin="0,0,8,8" Tag="{Binding}"
                                            Visibility="{Binding Instalado, Converter={StaticResource BoolVis}}" Click="Abrir_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding TextoInstalar}" Padding="14,8" Margin="0,0,8,8" Tag="{Binding}"
                                            IsEnabled="{Binding PodeInstalar}" Click="Instalar_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="PASTA" Padding="12,8" Margin="0,0,8,8" Tag="{Binding}"
                                            Visibility="{Binding Instalado, Converter={StaticResource BoolVis}}" Click="Pasta_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="GUIA OFICIAL" Padding="12,8" Margin="0,0,8,8" Tag="{Binding}" Click="Site_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Foreground="{DynamicResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,18,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Cada projeto tem sua própria licença (GPL) e seus autores; o Hefesto não contém código deles, só baixa os pacotes oficiais e os abre. Os arquivos ficam em %LocalAppData%\Hefesto\Classicos."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
