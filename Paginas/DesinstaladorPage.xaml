<UserControl x:Class="Hefesto.DesinstaladorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">
            <TextBlock Text="DESINSTALADOR" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Roda o desinstalador oficial do programa e depois procura pastas que ficaram para trás. As sobras só saem depois que você conferir, e vão para a Lixeira. O registro do Windows não é alterado."/>

            <Grid Margin="0,20,0,0" MaxWidth="820" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Busca" MinWidth="360" Padding="8,7" TextChanged="Busca_TextChanged" ToolTip="Filtrar por nome ou fabricante"/>
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="ATUALIZAR LISTA" Padding="16,9" Margin="10,0,0,0" Click="Recarregar_Click"/>
            </Grid>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Text="Carregando…"/>

            <!-- Sobras (aparece depois de desinstalar) -->
            <Border x:Name="PainelSobras" BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0" Padding="16,4,0,4" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SobrasTitulo" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20"/>
                    <TextBlock x:Name="SobrasSub" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8" MaxWidth="800" HorizontalAlignment="Left"/>
                    <ItemsControl x:Name="ListaSobras">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selecionada}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Item.Caminho}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Tamanho}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="14,0"/>
                                        <Button Grid.Column="3" Style="{StaticResource OutlineButton}" Content="MOSTRAR" Padding="10,4" FontSize="11"
                                                Tag="{Binding Item.Caminho}" Click="Mostrar_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="BtnSobras" Style="{StaticResource AccentButton}" Content="ENVIAR MARCADAS PARA A LIXEIRA" Padding="18,9" Margin="0,0,10,0" Click="Sobras_Click"/>
                        <Button Style="{StaticResource OutlineButton}" Content="DEIXAR COMO ESTÁ" Padding="14,9" Click="FecharSobras_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="Lista" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Nome}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TamanhoTexto}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="16,0"/>
                                <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="DESINSTALAR" Padding="12,5" FontSize="11"
                                        VerticalAlignment="Center" Tag="{Binding}" Click="Desinstalar_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
