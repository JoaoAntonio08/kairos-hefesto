<UserControl x:Class="Hefesto.LimpezaProfundaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Linha de regra (Lixo no disco inteiro e winapp2) -->
        <DataTemplate x:Key="RegraTemplate">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selecionada}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Nome}" FontWeight="Medium" FontSize="14"/>
                        <TextBlock Text="{Binding Descricao}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="24,0,0,0" MinWidth="120">
                        <TextBlock Text="{Binding TotalTexto}" Style="{StaticResource Big}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Contagem}" Foreground="{DynamicResource Faint}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">
            <TextBlock Text="LIMPEZA PROFUNDA" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Veja o que ocupa o disco, procure lixo no disco inteiro e use as regras da comunidade winapp2. Como na Limpeza rápida, nada é apagado de vez."/>

            <WrapPanel Margin="0,22,0,0">
                <RadioButton x:Name="AbaMapa" Style="{StaticResource Chip}" GroupName="ProfAba" Content="MAPA DO DISCO" IsChecked="True" Checked="Aba_Checked"/>
                <RadioButton x:Name="AbaLixo" Style="{StaticResource Chip}" GroupName="ProfAba" Content="LIXO NO DISCO INTEIRO" Checked="Aba_Checked"/>
                <RadioButton x:Name="AbaW2" Style="{StaticResource Chip}" GroupName="ProfAba" Content="REGRAS WINAPP2" Checked="Aba_Checked"/>
            </WrapPanel>

            <CheckBox x:Name="Simulacao" Content="Modo simulação (só mostra, não mexe em nada)" IsChecked="True" Margin="0,10,0,0"
                      Checked="Simulacao_Changed" Unchecked="Simulacao_Changed"/>

            <!-- Progresso e status (comuns) -->
            <Grid Height="3" Margin="0,18,0,8" Background="{DynamicResource Line}">
                <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="Progresso" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCancelar" Style="{StaticResource OutlineButton}" Content="CANCELAR" Padding="14,6" Margin="0,0,12,0" Visibility="Collapsed" Click="Cancelar_Click"/>
                <Button x:Name="BtnRelatorio" Style="{StaticResource OutlineButton}" Content="ABRIR RELATÓRIO" Padding="14,6" Margin="0,0,12,0" Visibility="Collapsed" Click="Relatorio_Click"/>
            </StackPanel>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Escolha um disco e clique em MAPEAR para ver o que ocupa espaço."/>

            <!-- ================= MAPA DO DISCO ================= -->
            <StackPanel x:Name="PainelMapa" Margin="0,18,0,0">
                <WrapPanel x:Name="Discos"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="BtnMapear" Style="{StaticResource AccentButton}" Content="MAPEAR" Padding="26,10" Margin="0,0,10,8" Click="Mapear_Click"/>
                    <Button x:Name="BtnSubir" Style="{StaticResource OutlineButton}" Content="↑ SUBIR" Padding="16,10" Margin="0,0,10,8" IsEnabled="False" Click="Subir_Click"/>
                    <Button x:Name="BtnMaiores" Style="{StaticResource OutlineButton}" Content="MAIORES ARQUIVOS" Padding="16,10" Margin="0,0,10,8" IsEnabled="False" Click="Maiores_Click"/>
                </WrapPanel>
                <TextBlock x:Name="MapaCaminho" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MapaSub" Foreground="{DynamicResource Muted}" Margin="0,2,0,8"/>
                <ItemsControl x:Name="ListaMapa">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Fg}"
                                            Tag="{Binding}" Click="Abrir_Click" Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icone}" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Muted}" Margin="0,2,8,0"/>
                                                <TextBlock Text="{Binding Nome}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="10,1,0,0"/>
                                            </StackPanel>
                                            <Grid Height="5" Margin="0,6,0,0" Background="{DynamicResource Line}">
                                                <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fracao}"/></Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding TamanhoTexto}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="18,0" MinWidth="80" TextAlignment="Right"/>
                                    <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="MOSTRAR" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Tag="{Binding}" Click="MostrarNo_Click"/>
                                    <Button Grid.Column="3" Style="{StaticResource OutlineButton}" Content="LIXEIRA" Padding="10,4" FontSize="11"
                                            VerticalAlignment="Center" Tag="{Binding}" Click="LixeiraNo_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ================= LIXO NO DISCO INTEIRO ================= -->
            <StackPanel x:Name="PainelLixo" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                           Text="Procura miniaturas soltas, restos do macOS, __pycache__, despejos .dmp e .tmp antigos em todos os discos. Em NTFS lê a tabela de arquivos (MFT) direto, o que leva segundos; em pendrives e HDs exFAT/FAT32 vai pasta por pasta. Nada dentro de repositórios git é tocado."/>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnLixo" Style="{StaticResource AccentButton}" Content="ANALISAR" Padding="26,10" Margin="0,0,10,8" Click="AnalisarLixo_Click"/>
                    <Button x:Name="BtnLimparLixo" Style="{StaticResource PrimaryButton}" Content="LIMPAR SELECIONADOS" Padding="20,10" Margin="0,0,10,8" IsEnabled="False" Click="LimparLixo_Click"/>
                </WrapPanel>
                <TextBlock x:Name="LixoTotal" Style="{StaticResource Hero}" FontSize="56" Margin="0,16,0,0" Visibility="Collapsed"/>
                <ItemsControl x:Name="ListaLixo" ItemTemplate="{StaticResource RegraTemplate}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- ================= WINAPP2 ================= -->
            <StackPanel x:Name="PainelW2" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                           Text="Milhares de regras de limpeza para programas específicos, mantidas pela comunidade. O Hefesto baixa o arquivo do repositório oficial, usa só as regras de arquivos (nunca mexe no registro) e mostra apenas as que se aplicam a este PC. Todas vêm desmarcadas: marque só o que você reconhece."/>
                <TextBlock x:Name="W2Credito" Foreground="{DynamicResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Regras: Winapp2.ini, projeto Winapp2 (github.com/MoscaDotTo/Winapp2), licença CC BY-SA 4.0. Baixado em tempo de execução, não faz parte do Hefesto."/>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnW2" Style="{StaticResource AccentButton}" Content="ANALISAR" Padding="26,10" Margin="0,0,10,8" Click="AnalisarW2_Click"/>
                    <Button x:Name="BtnW2Baixar" Style="{StaticResource OutlineButton}" Content="BAIXAR REGRAS DE NOVO" Padding="16,10" Margin="0,0,10,8" Click="BaixarW2_Click"/>
                    <Button x:Name="BtnLimparW2" Style="{StaticResource PrimaryButton}" Content="LIMPAR SELECIONADOS" Padding="20,10" Margin="0,0,10,8" IsEnabled="False" Click="LimparW2_Click"/>
                </WrapPanel>
                <TextBlock x:Name="W2Total" Style="{StaticResource Hero}" FontSize="56" Margin="0,16,0,0" Visibility="Collapsed"/>
                <ItemsControl x:Name="ListaW2" ItemTemplate="{StaticResource RegraTemplate}" Margin="0,10,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
