<UserControl x:Class="Hefesto.BackupSavesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">
            <TextBlock Text="BACKUP DE SAVES" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Junta num .zip os saves de Saved Games, Documentos\My Games, os saves da Steam e as pastas que você adicionar. As pastas originais não são alteradas."/>

            <WrapPanel Margin="0,20,0,0">
                <Button x:Name="BtnBackup" Style="{StaticResource AccentButton}" Content="FAZER BACKUP" Padding="24,10" Margin="0,0,10,8" Click="Backup_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="ADICIONAR PASTA" Padding="16,10" Margin="0,0,10,8" Click="Adicionar_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="ABRIR BACKUPS" Padding="16,10" Margin="0,0,10,8" Click="AbrirBackups_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="PROCURAR DE NOVO" Padding="16,10" Margin="0,0,10,8" Click="Procurar_Click"/>
            </WrapPanel>
            <Grid Height="3" Margin="0,8,0,8" Background="{DynamicResource Line}">
                <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="Progresso" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="Procurando saves…"/>
            <TextBlock x:Name="Total" Style="{StaticResource Hero}" FontSize="56" Margin="0,16,0,0"/>

            <ItemsControl x:Name="Lista" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selecionada}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Nome}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource Faint}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TamanhoTexto}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="16,0"/>
                                <Button Grid.Column="3" Style="{StaticResource OutlineButton}" Content="MOSTRAR" Padding="10,4" FontSize="11"
                                        VerticalAlignment="Center" Tag="{Binding Caminho}" Click="Mostrar_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Foreground="{DynamicResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,16,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Jogos que salvam em outros lugares (ex.: AppData) podem ser incluídos com ADICIONAR PASTA. Cada .zip tem um LEIA-ME com o lugar de origem de cada pasta, para restaurar."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
