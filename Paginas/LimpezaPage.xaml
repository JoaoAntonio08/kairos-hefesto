<UserControl x:Class="Hefesto.LimpezaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">
            <TextBlock Text="LIMPEZA RÁPIDA" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Temporários, despejos de travamento, caches e instaladores velhos. Nada é apagado de vez: tudo vai para a Lixeira (ou para a quarentena, se não couber)."/>

            <!-- Opções -->
            <WrapPanel Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,26,10">
                    <TextBlock Text="Temporários e despejos com mais de" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    <TextBox x:Name="DiasTemp" Width="54" Margin="8,0" TextAlignment="Center"/>
                    <TextBlock Text="dias" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,26,10">
                    <TextBlock Text="Instaladores com mais de" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    <TextBox x:Name="DiasInst" Width="54" Margin="8,0" TextAlignment="Center"/>
                    <TextBlock Text="dias" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
                <CheckBox x:Name="Simulacao" Content="Modo simulação (só mostra, não mexe em nada)" IsChecked="True"
                          Margin="0,0,0,10" VerticalAlignment="Center" Checked="Simulacao_Changed" Unchecked="Simulacao_Changed"/>
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="BtnAnalisar" Style="{StaticResource AccentButton}" Content="ANALISAR" Padding="26,10" Margin="0,0,10,8" Click="Analisar_Click"/>
                <Button x:Name="BtnLimpar" Style="{StaticResource PrimaryButton}" Content="LIMPAR SELECIONADOS" Padding="20,10" Margin="0,0,10,8"
                        IsEnabled="False" Click="Limpar_Click"/>
                <Button x:Name="BtnRelatorio" Style="{StaticResource OutlineButton}" Content="ABRIR RELATÓRIO" Padding="16,10" Margin="0,0,10,8"
                        IsEnabled="False" Click="Relatorio_Click"/>
                <Button Style="{StaticResource OutlineButton}" Content="QUARENTENA" Padding="16,10" Margin="0,0,10,8" Click="Quarentena_Click"/>
                <Button x:Name="BtnCancelar" Style="{StaticResource OutlineButton}" Content="CANCELAR" Padding="16,10" Margin="0,0,10,8"
                        Visibility="Collapsed" Click="Cancelar_Click"/>
            </WrapPanel>

            <Grid Height="3" Margin="0,8,0,8" Background="{DynamicResource Line}">
                <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="Progresso" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       Text="Clique em ANALISAR para ver quanto espaço dá para liberar. Com o modo simulação ligado, nada é alterado."/>

            <!-- Resultado em destaque -->
            <StackPanel x:Name="Destaque" Margin="0,26,0,10" Visibility="Collapsed">
                <TextBlock x:Name="TotalTexto" Style="{StaticResource Hero}" FontSize="64"/>
                <TextBlock x:Name="TotalSub" Foreground="{DynamicResource Muted}" FontSize="14"/>
            </StackPanel>

            <!-- Regras -->
            <ItemsControl x:Name="ListaRegras" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selecionada}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Nome}" FontWeight="Medium" FontSize="14"/>
                                    <TextBlock Text="{Binding Descricao}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="24,0,0,0" MinWidth="120">
                                    <TextBlock Text="{Binding TotalTexto}" Style="{StaticResource Big}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Contagem}" Foreground="{DynamicResource Faint}" FontSize="11.5" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pode ser seu -->
            <StackPanel x:Name="PainelSeu" Margin="0,34,0,0" Visibility="Collapsed">
                <TextBlock Text="Pode ser seu" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20"/>
                <TextBlock x:Name="SeuSub" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" MaxWidth="820" HorizontalAlignment="Left"/>
                <ItemsControl x:Name="ListaSeu">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Motivo}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        <TextBlock Text="{Binding Pasta}" Foreground="{DynamicResource Faint}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TamanhoTexto}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="16,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="MOSTRAR" Padding="10,4" FontSize="11"
                                            VerticalAlignment="Center" Tag="{Binding Caminho}" Click="Mostrar_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Quarentena -->
            <StackPanel x:Name="PainelQuarentena" Margin="0,34,0,0" Visibility="Collapsed">
                <TextBlock Text="Quarentena" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="20"/>
                <TextBlock x:Name="QuarentenaSub" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" MaxWidth="820" HorizontalAlignment="Left"/>
                <ItemsControl x:Name="ListaQuarentena">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Original}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11.5">
                                            <Run Text="{Binding Data, StringFormat='dd/MM/yyyy HH:mm', Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="RESTAURAR" Padding="10,4" FontSize="11"
                                            VerticalAlignment="Center" Margin="16,0,0,0" Tag="{Binding}" Click="Restaurar_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
